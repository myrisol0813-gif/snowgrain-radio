{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "snowgrain-radio",
  "main": "src/index.js",
  "compatibility_date": "2026-11-22",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "snowgrain-radio",
      "database_id": "b0f642d3-ca85-42cb-95a8-6c1d3683ba25",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "snowgrain-radio-media"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAGM4Xj89TEx278XK",
    "RATE_LIMIT_MAX": "12"
  }
}
